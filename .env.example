PORT=3000
FENNLO_DATA_DIR=./data
# Optional. Without a key, the explicitly labeled development provider is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-image
# This model supports 1K only. Other configured native image models may support 512/2K/4K.
GEMINI_IMAGE_SIZE=1K
GEMINI_ASPECT_RATIO=16:9
# Maximum essential points/images in one native request; 2-4 allowed, default 3.
FENNLO_MAX_POINTS=3
# Optional deterministic override even when a Gemini key is configured.
# FENNLO_PROVIDER=development
# Required only for owner-only artifact writes over HTTP.
FENNLO_OWNER_TOKEN=
